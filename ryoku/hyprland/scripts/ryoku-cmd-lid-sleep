#!/bin/bash

# Lid Sleep quick-toggle's durable override. logind's own default
# (HandleLidSwitch=suspend) is left completely alone while the toggle is on --
# this script has nothing to do then. Switched off, it holds a
# `handle-lid-switch` inhibitor (systemd-run --user, setsid fallback, same
# shape as ryoku-cmd-caffeine) so logind can no longer act on the lid switch
# itself, and runs its own watch loop under that same inhibitor that dpms's
# the screen off on close / on on open -- so the screen still blanks, but
# nothing suspends until the normal idle timeout (hypridle.conf) does. the
# request is persisted so a fresh login can pick it back up.

set -euo pipefail

self="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"

state_dir="${RYOKU_STATE_PATH:-${XDG_STATE_HOME:-$HOME/.local/state}/ryoku}"
state_file="${RYOKU_LIDSLEEP_STATE_FILE:-$state_dir/lid-sleep-override.enabled}"
lock_file="${RYOKU_LIDSLEEP_LOCK_FILE:-${XDG_RUNTIME_DIR:-/tmp}/ryoku-lidsleep.lock}"
unit_name="${RYOKU_LIDSLEEP_UNIT_NAME:-ryoku-lidsleep-override}"

watch_pattern="[r]yoku-lidsleep-watch"
desired_inhibit_pattern="(^|/)systemd-inhibit --what=handle-lid-switch --who=Ryoku .*Ryoku lid-sleep override"

usage() {
  cat <<'EOF'
Usage:
  ryoku-cmd-lid-sleep status    # exit 0 when the override is active (sleep-on-lid-close is disabled)
  ryoku-cmd-lid-sleep start     # persist the request and hold the override
  ryoku-cmd-lid-sleep stop      # clear the request and release the override, restoring logind's default
  ryoku-cmd-lid-sleep restore   # re-hold the override iff a request is persisted
  ryoku-cmd-lid-sleep toggle
EOF
}

command_present() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || return 1
  done
  return 0
}

helper_watch_active() { pgrep -f "$watch_pattern" >/dev/null; }
desired_inhibitor_active() { pgrep -f "$desired_inhibit_pattern" >/dev/null; }
override_active() { desired_inhibitor_active || helper_watch_active; }
override_requested() { [[ -f $state_file ]] && grep -Fxq "enabled" "$state_file"; }

persist_override_state() {
  mkdir -p "$(dirname "$state_file")"
  printf '%s\n' "enabled" >"$state_file"
}
clear_override_state() { rm -f "$state_file"; }

with_lidsleep_lock() {
  mkdir -p "$(dirname "$lock_file")"
  (
    flock -x 9
    "$@"
  ) 9>"$lock_file"
}

override_unit_active() {
  command_present systemctl || return 1
  systemctl --user is-active --quiet "$unit_name.service" >/dev/null 2>&1
}

start_inhibitor_with_systemd() {
  command_present systemd-run || return 1
  systemd-run \
    --user --quiet --collect \
    --unit="$unit_name" \
    --description="Ryoku lid-sleep override (screen off, no suspend)" \
    systemd-inhibit \
    --what=handle-lid-switch \
    --who=Ryoku \
    --why="Ryoku lid-sleep override: screen off only" \
    bash -c 'exec -a ryoku-lidsleep-watch bash "$0" __watch' "$self" 9>&- >/dev/null 2>&1
}

start_inhibitor_with_setsid() {
  setsid systemd-inhibit \
    --what=handle-lid-switch \
    --who=Ryoku \
    --why="Ryoku lid-sleep override: screen off only" \
    bash -c 'exec -a ryoku-lidsleep-watch bash "$0" __watch' "$self" 9>&- >/dev/null 2>&1 &
}

start_inhibitor() {
  if desired_inhibitor_active; then
    if override_unit_active || ! command_present systemd-run systemctl; then
      return 0
    fi
  fi
  pkill -f "$watch_pattern" >/dev/null 2>&1 || true
  start_inhibitor_with_systemd || start_inhibitor_with_setsid
}

wait_for_inhibitor() {
  for _ in {1..20}; do
    desired_inhibitor_active && return 0
    sleep 0.05
  done
  return 1
}

stop_inhibitor() {
  command_present systemctl && systemctl --user stop "$unit_name.service" >/dev/null 2>&1 || true
  pkill -f "$watch_pattern" >/dev/null 2>&1 || true
}

hold_override() { start_inhibitor; wait_for_inhibitor; }
start_override() { persist_override_state; hold_override; }
stop_override() { clear_override_state; stop_inhibitor; }
restore_override() { override_requested || return 0; start_override; }
toggle_override() { if override_requested || override_active; then stop_override; else start_override; fi; }

# runs inside the held inhibitor, argv0 spoofed to $watch_pattern above.
# polls LidClosed (same poll idiom the other quick-toggle probes use, rather
# than parsing a dbus-monitor/busctl-monitor event stream) and only dpms's on
# an actual open/close transition -- including one right away on start, so
# flipping the toggle while the lid is already closed doesn't leave the
# screen lit until the next physical open/close.
#
# dpms via `hl.dsp.dpms(...)`, NOT the vanilla `hyprctl dispatch dpms off` --
# this repo's Hyprland runs the Lua config parser, which rejects a bare
# "dispatch <word> <word>" as invalid Lua (same reason ryoku-workspace
# dispatches through hl.dsp.* instead of plain dispatch strings), AND its
# `hl.dsp.dpms` ignores whatever argument it's given (string or bool) and
# just TOGGLES the current state -- confirmed live by calling it twice with
# the same "on" argument back to back and watching the panel go off, not
# stay on. So dpms_set() below only fires the toggle when the live
# monitors[].dpmsStatus already disagrees with what's wanted, making a
# stateless toggle behave like a real set.
# NOT `.[0].dpmsStatus // empty` -- jq's `//` treats a literal `false` as
# "no value" too, so that form silently printed nothing (indistinguishable
# from a real read failure) every time the screen was legitimately off, and
# dpms_set below mistook that for an unreadable status and skipped the
# toggle -- confirmed live: it's what left the panel stuck off after a
# close/reopen. `.[0]` is null only when monitors -j genuinely has no entry.
dpms_status() {
  hyprctl monitors -j 2>/dev/null | jq -r '.[0].dpmsStatus | if . == null then empty else tostring end'
}
dpms_set() {
  local want=$1 cur
  cur="$(dpms_status)"
  [[ -n $cur ]] || return 0
  [[ $cur != "$want" ]] || return 0
  hyprctl dispatch 'hl.dsp.dpms(true)' >/dev/null 2>&1 || true
}
watch_lid() {
  local last="" cur
  while true; do
    cur="$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
      org.freedesktop.login1.Manager LidClosed 2>/dev/null | awk '{print $2}')"
    if [[ -n $cur && $cur != "$last" ]]; then
      if [[ $cur == "true" ]]; then
        dpms_set false
      else
        dpms_set true
      fi
      last="$cur"
    fi
    sleep 1
  done
}

case "${1:-}" in
  status)  override_active ;;
  start)   with_lidsleep_lock start_override ;;
  stop)    with_lidsleep_lock stop_override ;;
  restore) with_lidsleep_lock restore_override ;;
  toggle)  with_lidsleep_lock toggle_override ;;
  __watch) watch_lid ;;
  --help|-h|"") usage ;;
  *) echo "ryoku-cmd-lid-sleep: unknown action: $1" >&2; usage >&2; exit 2 ;;
esac
