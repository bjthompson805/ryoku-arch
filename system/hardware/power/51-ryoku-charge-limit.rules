// The battery popout's charge-limit field, authorized without a password so
// changing the percentage stays one step. Scoped to exactly
// /usr/bin/ryoku-charge-limit for an active local user in the wheel group. The
// helper only rewrites its own fixed udev rule from a range-checked whole number
// and restarts upower, so a passwordless grant is safe.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") === "/usr/bin/ryoku-charge-limit" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
