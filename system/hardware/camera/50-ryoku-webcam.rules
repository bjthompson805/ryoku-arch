// Webcam kill-switch helper, authorized without a password so the deck toggle
// stays one click. Scoped to exactly /usr/bin/ryoku-webcam for an active local
// user in the wheel group. The helper only chmods UVC /dev/video* nodes (which
// it re-derives itself, never from a caller-supplied path) and loads/unloads
// the v4l2loopback module with fixed parameters -- no arbitrary input either
// way, so a passwordless grant is safe.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") === "/usr/bin/ryoku-webcam" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
