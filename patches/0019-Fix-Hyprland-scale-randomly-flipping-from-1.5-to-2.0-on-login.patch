From b701c5a0f9c76d10b3abfe6b3574c74c9134bf46 Mon Sep 17 00:00:00 2001
From: Brandon Thompson <brandon.joseph.thompson@gmail.com>
Date: Thu, 6 Aug 2026 20:01:05 -0700
Subject: [PATCH] Patch: Fix Hyprland scale randomly flipping from 1.5 to 2.0
 on login

autoscale computes each output's scale deterministically from EDID DPI
(px * 25.4 / physical-mm, snapped to a Hyprland-valid multiple), then
pushes it live with a single `hyprctl eval` and immediately persists
whatever hyprctl reports back into monitors.lua.

That single apply isn't safe at login: Hyprland can still be settling
the panel on its own after the compositor starts (observed eDP-1
modeset three separate times in one boot in the Hyprland log), and an
eval that lands mid-negotiation gets silently overwritten by
Hyprland's own resolution a moment later. Since write_monitors_conf
trusts whatever's live at the end without re-checking, a clobbered
apply doesn't just misfire once -- it gets baked into monitors.lua and
persists into the next login too, until a luckier-timed run overwrites
it correctly again.

settle_modes already re-asserts mode drift the same way for the
analogous cold-boot fallback-resolution case; extend the same bounded
retry (verify live matches wanted, reapply if not, up to 5 tries)
to scale application.
---
 system/hardware/display/ryoku-monitor | 35 +++++++++++++++++++--------
 1 file changed, 25 insertions(+), 10 deletions(-)

diff --git a/system/hardware/display/ryoku-monitor b/system/hardware/display/ryoku-monitor
index 52d21254..8c1b24d0 100755
--- a/system/hardware/display/ryoku-monitor
+++ b/system/hardware/display/ryoku-monitor
@@ -291,16 +291,31 @@ cmd_autoscale() {
   # two passes. first, apply each monitor's DPI scale: Hyprland snaps a
   # requested scale to the nearest one that yields whole logical pixels (e.g.
   # 1.5 on a 2560 panel -> 1.6), so the accepted scale is only known once
-  # it's applied.
-  local name mode wanted current
-  while IFS='|' read -r name mode _ wanted current; do
-    [[ -n $name ]] || continue
-    grep -qxF "$name" <<<"$pinned" && continue
-    if awk -v a="$current" -v b="$wanted" 'BEGIN { exit (a == b) ? 1 : 0 }'; then
-      apply_monitor "output = \"$name\", mode = \"$mode\", scale = $wanted"
-      echo "ryoku-monitor: $name -> scale $wanted"
-    fi
-  done < <(monitors_json | dpi_specs)
+  # it's applied. re-checked and reapplied a few times (bounded, like
+  # settle_modes below): at login the panel can still be modesetting on its
+  # own -- observed 2-3 modesets for a single internal eDP panel during one
+  # boot -- and a `hyprctl eval` that lands mid-negotiation gets silently
+  # overwritten by Hyprland's own resolution a moment later, so a single
+  # apply isn't trustworthy here. write_monitors_conf below persists whatever
+  # is live once this loop is done, so an unnoticed clobber would otherwise
+  # get baked into the drop-in and outlive the session.
+  local name mode wanted current tries=0 max_tries=5 drift
+  while ((tries < max_tries)); do
+    drift=0
+    while IFS='|' read -r name mode _ wanted current; do
+      [[ -n $name ]] || continue
+      grep -qxF "$name" <<<"$pinned" && continue
+      if awk -v a="$current" -v b="$wanted" 'BEGIN { exit (a == b) ? 1 : 0 }'; then
+        apply_monitor "output = \"$name\", mode = \"$mode\", scale = $wanted"
+        echo "ryoku-monitor: $name -> scale $wanted"
+        drift=1
+      fi
+    done < <(monitors_json | dpi_specs)
+    ((drift)) || break
+    [[ -n ${RYOKU_MONITOR_JSON:-} ]] && break
+    tries=$((tries + 1))
+    ((tries < max_tries)) && sleep 0.3
+  done
 
   # then lay the displays in one non-overlapping row, left-to-right by current
   # x, advancing by each monitor's real logical width (pixels / accepted scale).
-- 
2.55.0

