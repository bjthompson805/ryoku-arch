+
     Item {
         id: trackRow
         anchors.fill: parent
diff --git a/ryoku/shell/quickshell/pill/Singletons/Devices.qml b/ryoku/shell/quickshell/pill/Singletons/Devices.qml
index c6863546..d75643f0 100644
--- a/ryoku/shell/quickshell/pill/Singletons/Devices.qml
+++ b/ryoku/shell/quickshell/pill/Singletons/Devices.qml
@@ -71,6 +71,11 @@ Singleton {
     property int backlightPct: -1
     readonly property bool backlightAvailable: root.backlightPct >= 0
 
+    // fires only for a user-driven change (sidebar fader commit, hardware key)
+    // so the OSD can flash the same way volume's live property does -- never
+    // for readBacklight()'s passive resync (hypridle dim/restore, sidebar open).
+    signal backlightUserChanged(int pct)
+
     function readBacklight() {
         blRead.running = true;
     }
@@ -82,6 +87,16 @@ Singleton {
         var p = Math.max(1, Math.min(100, Math.round(pct)));
         root.backlightPct = p;
         Quickshell.execDetached(["brightnessctl", "set", p + "%"]);
+        root.backlightUserChanged(p);
+    }
+
+    // record a change already applied elsewhere (a hardware key, via
+    // ryoku-cmd-brightness) and flash: no hardware call, brightnessctl was the
+    // one that just ran.
+    function reportBacklightChange(pct) {
+        var p = Math.max(0, Math.min(100, Math.round(pct)));
+        root.backlightPct = p;
+        root.backlightUserChanged(p);
     }
 
     Process {
diff --git a/ryoku/shell/quickshell/pill/shell.qml b/ryoku/shell/quickshell/pill/shell.qml
index cb37bdd7..f92d7f54 100644
--- a/ryoku/shell/quickshell/pill/shell.qml
+++ b/ryoku/shell/quickshell/pill/shell.qml
@@ -368,6 +368,9 @@ ShellRoot {
         function media(mon: string): void { root.sfc(mon, "media"); }
         function resources(mon: string): void { root.sfc(mon, "resources"); }
         function wallpaper(mon: string): void { root.sfc(mon, "wallpaper"); }
+        // hardware brightness keys already applied via ryoku-cmd-brightness; this
+        // just reports the new panel % so the OSD flashes, like volume's does.
+        function backlight(pct: string): void { Devices.reportBacklightChange(parseInt(pct, 10)); }
     }
 
     // The daemon writes surface commands to this socket to toggle pill surfaces
@@ -402,6 +405,8 @@ ShellRoot {
         case "pluginPopout":
             root.togglePopout(mon, "plugin:" + (parts.length > 2 ? parts[2] : ""));
