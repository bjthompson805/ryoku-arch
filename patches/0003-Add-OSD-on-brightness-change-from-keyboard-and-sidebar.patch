From 9afaf7a3c483838d3f7f27c635bccc9c442d180e Mon Sep 17 00:00:00 2001
From: Brandon Thompson <brandon.joseph.thompson@gmail.com>
Date: Sat, 18 Jul 2026 15:47:54 -0700
Subject: Patch: Add OSD on brightness change from keyboard and sidebar.

Redesigned for beta-18: upstream's hardware-key path moved off the Go
daemon onto a standalone script (ryoku-cmd-brightness, direct from
binds.lua) that also drives external DDC monitors, which the original
patch's daemon-side backlightAdjust() never did. Ported the OSD-flash
half of the original patch (Devices.qml state + signal, Osd.qml row,
shell.qml IPC plumbing) but re-pointed the report path: the script
calls the existing `ryoku-shell` client with a new `backlight <pct>`
verb (added to daemon.go/main.go) instead of the daemon computing the
delta itself, since the script already applied it.

Sidebar fader commits flash too, for free: BrightnessControl.qml
already funnels through Devices.setBacklight(), which now emits the
same user-changed signal the OSD listens for.
---
 ryoku/hyprland/scripts/ryoku-cmd-brightness   |  7 +++
 ryoku/shell/ipc/daemon.go                     |  9 +++
 ryoku/shell/ipc/ipc-surface.txt               |  3 +
 ryoku/shell/ipc/main.go                       |  1 +
 ryoku/shell/quickshell/pill/Osd.qml           | 59 +++++++++++++++++++
 .../quickshell/pill/Singletons/Devices.qml    | 15 +++++
 ryoku/shell/quickshell/pill/shell.qml         |  5 ++
 7 files changed, 99 insertions(+)

diff --git a/ryoku/hyprland/scripts/ryoku-cmd-brightness b/ryoku/hyprland/scripts/ryoku-cmd-brightness
index 544b3a85..26363aea 100755
--- a/ryoku/hyprland/scripts/ryoku-cmd-brightness
+++ b/ryoku/hyprland/scripts/ryoku-cmd-brightness
@@ -25,6 +25,13 @@ if compgen -G "/sys/class/backlight/*" >/dev/null; then
   else
     brightnessctl set "${mag}%-" >/dev/null 2>&1 || true
   fi
+  # Report the new level so the pill can flash an OSD, the same way volume's
+  # live property already does. Backgrounded and best-effort: a slow or
+  # missing daemon must never add latency to a repeating hardware key.
+  (
+    pct=$(brightnessctl -m 2>/dev/null | awk -F, 'NR==1{print substr($4,1,length($4)-1)}')
+    [[ -n $pct ]] && ryoku-shell backlight "$pct" >/dev/null 2>&1
+  ) &
 fi
 
 # External monitors over DDC/CI. Always attempted, never fatal.
diff --git a/ryoku/shell/ipc/daemon.go b/ryoku/shell/ipc/daemon.go
index 17e20789..42443a6d 100644
--- a/ryoku/shell/ipc/daemon.go
+++ b/ryoku/shell/ipc/daemon.go
@@ -643,6 +643,15 @@ func (d *daemon) dispatch(line string) string {
 		}
 		d.ensure("pill")
 		return pillIpc("pluginPopout", d.activeMonitor(), args[0])
+	case "backlight":
+		// backlight <pct> -> ryoku-cmd-brightness already applied this to the
+		// panel (hardware keys); just relay the new % to the pill so its OSD
+		// flashes, the same way volume's live Pipewire property does.
+		if len(args) < 1 {
+			return "err backlight: need <pct>"
+		}
+		d.ensure("pill")
+		return pillIpc("backlight", args[0])
 	case "plugins":
 		// plugins reload -> the per-monitor PluginPopouts watch plugins.json and
 		// re-discover on change, so a Settings save retunes live; this is a no-op
