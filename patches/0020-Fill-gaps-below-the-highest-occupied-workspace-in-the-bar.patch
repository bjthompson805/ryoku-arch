From 66b6c1d8eed72d8376732878339ca83aca5d8986 Mon Sep 17 00:00:00 2001
From: Brandon Thompson <brandon.joseph.thompson@gmail.com>
Date: Sat, 8 Aug 2026 15:41:29 -0700
Subject: [PATCH] Patch: Fill gaps below the highest occupied workspace in the
 bar

The workspaces module's "only occupied workspaces" mode listed a
workspace only if it was individually occupied or the active one, so
an empty workspace sitting below a later occupied one just vanished
(ws3 has windows, ws2 doesn't -> ws2 disappears from the bar instead
of showing as an empty slot).

wsList now first finds the highest occupied workspace in the current
base-10 group, then includes every workspace up to it, falling back to
the individually-occupied-or-active check only past that point. The
active workspace still always shows even when it sits beyond the last
occupied one, so jumping to an empty far workspace doesn't fill the
whole range in between.

diff --git a/ryoku/shell/quickshell/pill/BarWorkspaces.qml b/ryoku/shell/quickshell/pill/BarWorkspaces.qml
index 463d6c9d..6772b717 100644
--- a/ryoku/shell/quickshell/pill/BarWorkspaces.qml
+++ b/ryoku/shell/quickshell/pill/BarWorkspaces.qml
@@ -143,9 +143,18 @@ Item {
     readonly property var wsList: {
         var out = [];
         if (Config.barOccupiedWorkspaces) {
+            // fill gaps below the highest occupied workspace too, so an empty
+            // ws2 still shows when ws3 has windows -- only the tail past the
+            // last occupied one (or the active one, if it sits further out)
+            // stays collapsed.
+            var maxOccupied = 0;
             for (var i = 1; i <= 10; i++) {
-                var id = base + i;
-                if (occupiedSet[id] || id === activeWsId)
+                if (occupiedSet[base + i])
+                    maxOccupied = i;
+            }
+            for (var j = 1; j <= 10; j++) {
+                var id = base + j;
+                if (j <= maxOccupied || id === activeWsId)
                     out.push(id);
             }
             if (out.length === 0)
