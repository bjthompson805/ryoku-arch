new file mode 100644
index 00000000..b7542311
--- /dev/null
+++ b/ryoku/hub/quickshell/pages/GeneralPage.qml
@@ -0,0 +1,31 @@
+import QtQuick
+import Ryoku.Ui
+import Ryoku.Ui.Singletons
+import ".."
+import "../schema/GeneralPage.js" as GeneralSchema
+
+// The General page. Desktop-wide preferences that aren't owned by any one
+// surface -- starts with the clock format, shared by every clock in the
+// shell. Content is the schema; the write ledger (state + diff) lives in the
+// shell's side column, no mock preview.
+Item {
+    id: pg
+    property var hub
+
+    readonly property string pTitle: I18n.tr("General")
+    readonly property string pEyebrow: I18n.tr("DESKTOP")
+    readonly property string pBlurb: I18n.tr("Desktop-wide preferences that aren't tied to one surface.")
+
+    SchemaPage {
+        anchors.fill: parent
+        schema: GeneralSchema.rows
+        draft: pg.hub ? pg.hub.draft : null
+        defaults: pg.hub ? pg.hub.committed : ({})
+        title: pg.pTitle
+        eyebrow: pg.pEyebrow
+        blurb: pg.pBlurb
+        query: pg.hub ? pg.hub.query : ""
+        onEdited: (k, v) => { if (pg.hub) pg.hub.edit(k, v); }
+        onPickRequested: (r) => { if (pg.hub) pg.hub.openPick(r); }
+    }
+}
