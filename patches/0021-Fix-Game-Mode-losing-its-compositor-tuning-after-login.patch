From d2a7f2053afe25a672130b2920c774aca60aa7e3 Mon Sep 17 00:00:00 2001
From: Brandon Thompson <brandon.joseph.thompson@gmail.com>
Date: Sat, 8 Aug 2026 15:41:41 -0700
Subject: [PATCH] Patch: Fix Game Mode losing its compositor tuning after login

Game Mode's compositor tuning (stripped blur/shadow/rounding,
animations off, tearing on) is a runtime `hyprctl eval` override the
shell re-applies on every login when the flag persisted on. It was
verified working in isolation, but after a real reboot the desktop
still came up with animations, blur, and full opacity active despite
Game Mode showing as on.

Traced with timestamped logging on an actual reboot: the eval landed
and verified within milliseconds of the shell starting, but the
compositor reverted afterward anyway. The culprit is wallInit, which
runs on every daemon bootstrap (the wallpaper daemon isn't alive yet
at a fresh login) and schedules an async theme repaint: `wallust run`
then `hyprctl reload config-only`. A reload rereads the Lua config
from scratch, silently wiping any runtime eval override -- Game
Mode's included -- and this repaint has no ordering against Game
Mode's own re-apply from the same login, so whichever lands second
wins.

paintWorker now checks ryoku-cmd-game-mode's own state marker right
after its reload and re-invokes `ryoku-cmd-game-mode start` when Game
Mode is on, so the theme repaint can no longer silently undo it.
Verified live by turning Game Mode on and triggering a repaint
directly (`ryoku-shell wallpaper repaint`): animations, blur, and
rounding all correctly held through the reload.

diff --git a/ryoku/shell/ipc/wallpaper.go b/ryoku/shell/ipc/wallpaper.go
index 7dee0118..905d1cf2 100644
--- a/ryoku/shell/ipc/wallpaper.go
+++ b/ryoku/shell/ipc/wallpaper.go
@@ -37,6 +37,15 @@ func liveDir() string   { return filepath.Join(os.Getenv("HOME"), "Pictures", "l
 func wallState() string { return filepath.Join(stateDir(), "ryoku-wallpaper") }
 func wallBag() string   { return filepath.Join(stateDir(), "ryoku-wallpaper-bag") }
 
+// gameModeOn reports whether ryoku-cmd-game-mode's own marker is present. Its
+// state lives under a "ryoku" subdirectory (unlike this file's flat
+// ryoku-*-prefixed files) because the script and the Flags.qml singleton share
+// that layout; mirror it here rather than plumb the path in.
+func gameModeOn() bool {
+	_, err := os.Stat(filepath.Join(stateDir(), "ryoku", "game-mode.enabled"))
+	return err == nil
+}
+
 // transition = flags appended after `awww img <pic>`. Super+W picks one at random
 // so consecutive switches feel varied.
 type transition struct {
@@ -559,6 +568,16 @@ func (d *daemon) paintWorker() {
 		}
 		_ = exec.Command("wallust", append([]string{"run", src}, tuneArgs()...)...).Run()
 		_ = exec.Command("hyprctl", "reload", "config-only").Run()
+		// a reload rereads the Lua config, which wipes any runtime `hyprctl eval`
+		// override -- including Game Mode's compositor tuning (see
+		// ryoku-cmd-game-mode's own hypr_fast comment). This repaint runs off
+		// wallInit at every daemon bootstrap, racing Game Mode's own re-apply from
+		// the same login with no ordering between the two, so a repaint landing
+		// second silently undoes it. Re-assert whenever Game Mode is the one
+		// currently on; idempotent and cheap either way.
+		if gameModeOn() {
+			_ = exec.Command("ryoku-cmd-game-mode", "start").Run()
+		}
 		select {
 		case d.ledsSig <- struct{}{}:
 		default:
-- 
