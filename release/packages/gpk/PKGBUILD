# Maintainer: Ryoku <releases@ryoku.dev>
#
# GlazePKG (gpk) = the official RyokuArch package manager. terminal dashboard
# that unifies every pkg manager on the system in one searchable view. ships in
# the [ryoku] repo and is a ryoku-desktop dep so a fresh install has it, vs
# leaning on the best-effort post-install AUR build.
#
# upstream is Go (github.com/neur0map/glazepkg); repackaged here from its release
# binary. This tracks upstream's latest release instead of a pinned version:
# pkgver() reads the tag GitHub's /releases/latest redirects to (the `upstream`
# script beside this file), and build() fetches that release's binary, so every
# rebuild ships whatever is newest.
# `gpk update` self-updates from upstream after install.
pkgname=gpk
pkgver=0
pkgrel=1
pkgdesc="GlazePKG: the RyokuArch package manager, every package manager in one view"
arch=('x86_64' 'aarch64')
url="https://github.com/neur0map/glazepkg"
license=('GPL-3.0-or-later')
depends=('pacman')
makedepends=('curl')
provides=('gpk')
conflicts=('gpk-bin')
replaces=('gpk-bin')
options=('!strip' '!debug')
source=()

pkgver() {
  "$startdir/upstream"
}

build() {
  local asset=gpk-linux-amd64
  if [[ $CARCH == aarch64 ]]; then asset=gpk-linux-arm64; fi
  curl -fsSL --retry 3 -o "$srcdir/gpk" "$url/releases/download/v$pkgver/$asset"
  # no checksum exists to pin against, so at least refuse an HTML error page
  [[ $(head -c4 "$srcdir/gpk" | tail -c3) == ELF ]] \
    || { echo "PKGBUILD: the downloaded gpk is not an ELF binary" >&2; return 1; }
}

package() {
  install -Dm755 "$srcdir/gpk" "$pkgdir/usr/bin/gpk"
}
